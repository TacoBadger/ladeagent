# Kopiér til .env. Aldrig commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# Valgfrit: ENTSO-E som anden datakilde (Energi Data Service kræver ingen nøgle)
ENTSOE_API_KEY=
# Model til agenten (default claude-opus-5). Evals kan køre flere: make eval MODELS="claude-opus-5 claude-sonnet-5"
LADEAGENT_MODEL=claude-opus-5
